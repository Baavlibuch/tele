FROM node:18 AS frontend_build
ENV DEBUG True
ENV TZ Asia/Kolkata
ENV NODE_OPTIONS=--openssl-legacy-provider
# EXPOSE 80
WORKDIR /app
COPY ./ /app
# RUN npm install -g yarn
RUN yarn install
RUN yarn run build-linux

# RUN mkdir /etc/nginx/
# RUN mkdir /etc/nginx/conf.d/

FROM nginx:alpine
WORKDIR /app
COPY --from=frontend_build /app/build /var/www/tele

# RUN cp -pr /code/build/ /var/www/html
# RUN echo ls /etc/nginx/conf.d/

COPY ./nginx_conf /etc/nginx/nginx.conf
COPY nginx.sh /app/nginx.sh
RUN chmod +x /app/nginx.sh

ENV PORT 8080
CMD ["/app/nginx.sh"]
