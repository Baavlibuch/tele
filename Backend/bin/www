#!/usr/bin/env node
const app = require('../app');
const debug = require('debug')('server:server');
const http = require('http');
//const https = require('https');
let server = http.createServer(app);

const { Server } = require("socket.io");
const { createAdapter } = require("@socket.io/redis-adapter");
const { createClient } = require("redis");
const { makeChatNameSpace } = require("../chat/index");

const pubClient = createClient({ url: "redis://localhost:6379" });
const subClient = pubClient.duplicate();
pubClient.connect()
subClient.connect()

// Configure Socket.IO server with more permissive settings
const io = new Server(server, {
  // Redis adapter for scaling
  adapter: createAdapter(pubClient, subClient),
  
  // CORS settings - allow all origins in development
  cors: {
    origin: true, // Allow all origins in development
    methods: ["GET", "POST", "OPTIONS", "PUT", "DELETE"],
    credentials: true,
    allowedHeaders: ["Content-Type", "Authorization", "X-Requested-With", "Access-Control-Allow-Origin"]
  },
  
  // Transport settings
  transports: ['websocket', 'polling'], // Allow both WebSocket and polling
  allowUpgrades: true, // Allow protocol upgrade
  
  // Timeout settings
  pingTimeout: 60000,
  pingInterval: 25000,
  
  // Session and security
  cookie: false,
  serveClient: false,
  path: '/socket.io',
  
  // Compression
  perMessageDeflate: {
    threshold: 1024,
    clientNoContextTakeover: true
  },
  
  // Connection state recovery
  connectionStateRecovery: {
    maxDisconnectionDuration: 2 * 60 * 1000,
    skipMiddlewares: true
  },
  
  // Message handling
  maxHttpBufferSize: 1e8,
  
  // Debugging
  allowEIO3: true, // Enable v2/v3 compatibility
  allowRequest: (req, callback) => {
    console.log('Incoming connection from:', req.headers.origin);
    callback(null, true); // Allow all connections for now
  }
});

// Create and configure the chat namespace
const chatNamespace = io.of('/app_chat');

// Apply additional configuration to the namespace
chatNamespace.use((socket, next) => {
  // Add any authentication/authorization logic here if needed
  next();
});

// Initialize the chat namespace
const live_chat = makeChatNameSpace(chatNamespace);
console.log('Socket.IO namespaces created');
console.log('- Main namespace: /');
console.log('- Chat namespace: /app_chat');

let port = normalizePort(process.env.PORT || '3001');
app.set('port', port);

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
  console.log('Listening on ' + bind);
}

module.exports = { io, live_chat }

