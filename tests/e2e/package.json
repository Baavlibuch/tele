{
  "name": "telemedicine-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for Telemedicine Application",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest -c jest.config.js",
    "test:e2e:watch": "jest --watch -c jest.config.js"
  },
  "jest": {
    "preset": "jest-puppeteer",
    "testMatch": [
      "**/e2e/**/*.spec.js"
    ],
    "testTimeout": 30000,
    "setupFilesAfterEnv": [
      "expect-puppeteer"
    ],
    "globalSetup": "./setup.js",
    "globalTeardown": "./teardown.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/puppeteer": "^5.4.6",
    "expect-puppeteer": "^7.0.0",
    "jest": "^29.7.0",
    "jest-puppeteer": "^8.0.5",
    "prettier": "^2.8.8",
    "puppeteer": "^19.11.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "mongodb": "^6.19.0"
  }
}
